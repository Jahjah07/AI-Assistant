FROM python:3.12-slim

WORKDIR /service
RUN apt-get update \
    && apt-get install -y --no-install-recommends espeak-ng libsndfile1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-tts.txt ./
RUN python -m pip install --no-cache-dir \
      --timeout 300 --retries 5 \
      --index-url https://download.pytorch.org/whl/cpu torch \
    && python -m pip install --no-cache-dir --timeout 300 --retries 5 \
      -r requirements-tts.txt
COPY app ./app

EXPOSE 8766
CMD ["python", "-m", "uvicorn", "app.tts_main:app", "--host", "0.0.0.0", "--port", "8766"]
