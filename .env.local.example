OLLAMA_MODEL=qwen3:4b-instruct
# Local n8n workflow creation. Keep this key server-only; never use NEXT_PUBLIC_.
N8N_URL=http://localhost:5678
N8N_API_KEY=
# Read tools are configured in Settings → n8n tools, using this same n8n server.
# Their webhook secrets are encrypted using VOICE_SERVICE_SECRET; keep it stable.
# Local screen snapshots use a separate image-capable model, unloaded after each request.
OLLAMA_VISION_MODEL=qwen3-vl:2b
# Keep the model loaded to avoid another cold start after a few idle minutes.
OLLAMA_KEEP_ALIVE=30m
# Optional cloud brain: install Codex CLI and sign in with ChatGPT inside Jimmy.
# Leave blank to use Codex's default model for your account.
CODEX_MODEL=
# Optional absolute path to codex.exe, a native Codex binary, or its npm JS entrypoint.
CODEX_CLI_PATH=

# Required. The browser will show an HTTP Basic Auth login prompt.
JIMMY_AUTH_USERNAME=jimmy
JIMMY_AUTH_PASSWORD=replace-with-a-long-random-password

# Comma-separated hostnames that may serve Jimmy. Add an ngrok hostname when used.
JIMMY_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional extra origins for reverse-proxy setups where Origin and Host differ.
JIMMY_ALLOWED_ORIGINS=

# Optional: store Jimmy's memories in a Markdown note inside an Obsidian vault.
# Leave OBSIDIAN_VAULT_PATH empty to use storage/jimmy-memory.sqlite instead.
OBSIDIAN_VAULT_PATH=
OBSIDIAN_MEMORY_NOTE=Jimmy.md



# Real-time voice service. Generate at least 32 random characters and
# put the same value here and in the Python service environment.
VOICE_SERVICE_SECRET=replace-with-at-least-32-random-characters
VOICE_SERVICE_PUBLIC_WS_URL=ws://127.0.0.1:8765/ws/voice
MOONSHINE_MODEL=UsefulSensors/moonshine-streaming-small
VOICE_ENDPOINT_SILENCE_MS=2000

# Local sentence-level TTS. Voice prefixes: am/af = American male/female,
# bm/bf = British male/female.
TTS_SERVICE_URL=http://127.0.0.1:8766
KOKORO_VOICE=am_michael
KOKORO_LANGUAGE=a
KOKORO_SPEED=1.0

# Optional fallback location when browser geolocation is unavailable.
# WEATHER_LATITUDE=14.5995
# WEATHER_LONGITUDE=120.9842

# Optional app path overrides, only needed if these apps are installed somewhere unusual.
BRAVE_PATH=
CHROME_PATH=
# Optional: use this Chrome profile for open Chrome, websites, searches and YouTube.
# Folder name from chrome://version's Profile Path, not the displayed account name.
CHROME_PROFILE_DIRECTORY=
VISUAL_STUDIO_PATH=
STEAM_PATH=

# Optional ComfyUI image generation. Export a ComfyUI API workflow JSON and point here.
COMFYUI_URL=http://127.0.0.1:8000
COMFYUI_TIMEOUT_MS=600000
# Maximum simultaneous image jobs (clamped to 1-3).
COMFYUI_CONCURRENCY=1
COMFYUI_WORKFLOW_PATH=
COMFYUI_POSITIVE_NODE_ID=104:90
COMFYUI_POSITIVE_INPUT=text
COMFYUI_KSAMPLER_NODE_ID=104:92
COMFYUI_SEED_INPUT=seed
COMFYUI_LATENT_NODE_ID=104:91
COMFYUI_WIDTH_INPUT=width
COMFYUI_HEIGHT_INPUT=height
COMFYUI_SAVE_IMAGE_NODE_ID=60
COMFYUI_FILENAME_PREFIX_INPUT=filename_prefix

# Named websites: say "open CRM" or "open dashboard". ChatGPT, Google, YouTube are built in.
JIMMY_BROWSER_LINKS='{}'
